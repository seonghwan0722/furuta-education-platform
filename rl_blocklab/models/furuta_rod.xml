<!--
  Rotary Pendulum (Furuta Pendulum) - MuJoCo Model
  =================================================
  Body 계층:
    worldbody
    └── base (고정 기둥, 시각용)
    └── arm (수평 회전 팔)                  ← joint_arm(hinge, z축)
        └── pendulum (수직으로 매달린 막대)  ← joint_pend(hinge, x축)

  Actuator: arm hinge에 붙는 모터 (토크 제어)
  Sensor: arm 각도/각속도, pendulum 각도/각속도
-->
<mujoco model="rotary_pendulum">

  <!-- ============================================================
       시뮬레이션 옵션 - 물리 계산 방식
       ============================================================ -->
  <option timestep="0.002" integrator="RK4" gravity="0 0 -9.81"/>

  <!-- ============================================================
       기본값 - 아래에서 반복되는 속성 기본치
       ============================================================ -->
  <default>
    <joint armature="0.001" damping="0.001"/>
    <geom rgba="0.7 0.7 0.7 1"/>
    <!-- 움직이는 부품용 클래스: 충돌 계산 끔 (arm/pendulum이 base/바닥에 걸리는 것 방지) -->
    <default class="moving">
      <geom contype="0" conaffinity="0"/>
    </default>
  </default>

  <!-- ============================================================
       월드 - 여기 안의 모든 body가 시뮬레이션됨
       ============================================================ -->
  <worldbody>

    <!-- 바닥 (시각용) -->
    <geom name="floor" type="plane" size="1 1 0.05" rgba="0.9 0.9 0.9 1"/>

    <!-- 조명 -->
    <light name="top" pos="0 0 1.5" dir="0 0 -1" diffuse="0.8 0.8 0.8"/>

    <!-- 고정 기둥 (base) - 움직이지 않음. joint 없음 = 월드에 붙박이 -->
    <!-- 높이 0.5m로 세워서 pendulum이 자유롭게 스윙할 공간 확보 -->
    <geom name="base" type="cylinder" pos="0 0 0.25"
          size="0.03 0.25" rgba="0.3 0.3 0.3 1"/>

    <!-- =========================================================
         Arm - 수평으로 회전하는 팔
         부모: worldbody / joint: z축 hinge (수평 회전)
         ========================================================= -->
    <body name="arm" pos="0 0 0.5">

      <!-- 조인트: z축 중심 회전 (수평면에서 돌아감) -->
      <joint name="joint_arm" type="hinge" axis="0 0 1"
             pos="0 0 0" limited="false"/>

      <!-- Arm 모양: x방향으로 20cm 뻗은 원기둥 -->
      <!-- fromto: 시작점(0,0,0)에서 끝점(0.2,0,0)까지, 반지름 0.01 -->
      <geom name="arm_geom" class="moving" type="capsule"
            fromto="0 0 0  0.2 0 0" size="0.01"
            rgba="0.2 0.5 0.8 1" mass="0.05"/>

      <!-- =======================================================
           Pendulum - arm 끝에 매달린 막대
           부모: arm / joint: x축 hinge (arm 방향으로 회전)
           ======================================================= -->
      <body name="pendulum" pos="0.2 0 0">

        <!-- 조인트: x축 회전 (arm의 진행 방향축 기준으로 스윙) -->
        <joint name="joint_pend" type="hinge" axis="1 0 0"
               pos="0 0 0" limited="false"/>

        <!-- Pendulum 모양: 아래로 30cm 늘어진 원기둥 -->
        <geom name="pend_geom" class="moving" type="capsule"
              fromto="0 0 0  0 0 -0.3" size="0.008"
              rgba="0.8 0.3 0.2 1" mass="0.03"/>

      </body>
    </body>
  </worldbody>

  <!-- ============================================================
       Actuator - arm 조인트에 토크를 가하는 모터
       ============================================================ -->
  <actuator>
    <!-- motor: 지정된 조인트에 토크 인가 -->
    <!-- ctrlrange: 컨트롤 신호의 최대/최소 (Nm 단위 토크) -->
    <motor name="motor_arm" joint="joint_arm"
           gear="1" ctrlrange="-1 1"/>
  </actuator>

  <!-- ============================================================
       Sensor - 상태 관측 (강화학습에서 observation)
       ============================================================ -->
  <sensor>
    <jointpos name="arm_pos"    joint="joint_arm"/>
    <jointvel name="arm_vel"    joint="joint_arm"/>
    <jointpos name="pend_pos"   joint="joint_pend"/>
    <jointvel name="pend_vel"   joint="joint_pend"/>
  </sensor>

</mujoco>
